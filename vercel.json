{
  "buildCommand": "echo 'IlyassAI - Stripe System'",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/agent.js": {
      "maxDuration": 60
    },
    "api/image.js": {
      "maxDuration": 60
    },
    "api/video.js": {
      "maxDuration": 120
    },
    "api/create-checkout.js": {
      "maxDuration": 30
    },
    "api/webhook.js": {
      "maxDuration": 30
    },
    "api/subscription.js": {
      "maxDuration": 30
    },
    "api/tools.js": {
      "maxDuration": 30
    },
    "api/utilities.js": {
      "maxDuration": 60
    },
    "api/github.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/auth",
      "destination": "/auth-advanced.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/success",
      "destination": "/success.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/connectors",
      "destination": "/connectors.html"
    },
    {
      "source": "/api/subscription.js-status",
      "destination": "/api/subscription.js?action=status"
    },
    {
      "source": "/api/cancel-subscription",
      "destination": "/api/subscription.js?action=cancel"
    },
    {
      "source": "/api/billing-portal",
      "destination": "/api/subscription.js?action=portal"
    },
    {
      "source": "/api/search",
      "destination": "/api/tools.js?action=search"
    },
    {
      "source": "/api/moderate",
      "destination": "/api/tools.js?action=moderate"
    },
    {
      "source": "/api/parse",
      "destination": "/api/tools.js?action=parse"
    },
    {
      "source": "/api/video.js-status",
      "destination": "/api/video.js?action=status"
    },
    {
      "source": "/api/generate-video",
      "destination": "/api/video.js?action=generate"
    },
    {
      "source": "/api/memory",
      "destination": "/api/utilities.js?action=memory"
    },
    {
      "source": "/api/discover",
      "destination": "/api/utilities.js?action=discover"
    },
    {
      "source": "/api/transcribe",
      "destination": "/api/utilities.js?action=transcribe"
    },
    {
      "source": "/api/github.js-oauth-callback",
      "destination": "/api/github.js?action=oauth-callback"
    },
    {
      "source": "/api/agent.js-orchestrator",
      "destination": "/api/agent.js?action=orchestrate"
    },
    {
      "source": "/api/reasoning-engine",
      "destination": "/api/agent.js?action=reason"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
